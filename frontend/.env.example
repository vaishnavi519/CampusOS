# Copy to .env.local and adjust. Never commit a real .env file.

# Base path used by the API client. Leave as /api to use the Vite dev proxy.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api during `npm run dev`.
VITE_API_PROXY_TARGET=http://localhost:5000

# Initial data source: "demo" (in-browser sample data) or "live" (real backend).
# Can also be switched at runtime from the account menu.
VITE_API_MODE=demo
